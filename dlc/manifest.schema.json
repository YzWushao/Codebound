{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codebound language pack manifest, API 1",
  "type": "object",
  "required": ["schemaVersion", "id", "language", "title", "version", "engineApi", "minAppVersion", "entry", "runtime"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,40}$" },
    "language": { "type": "string", "minLength": 1, "not": { "const": "python" } },
    "title": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "engineApi": { "const": 1 },
    "minAppVersion": { "type": "string", "minLength": 1 },
    "entry": { "type": "string", "minLength": 1 },
    "runtime": { "type": "string", "minLength": 1 },
    "platforms": { "type": "array", "items": { "enum": ["windows"] }, "uniqueItems": true },
    "description": { "type": "string" }
  }
}
