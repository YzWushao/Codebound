{
  "name": "codebound",
  "version": "0.1.0-alpha.1",
  "description": "Codebound Windows 桌面版 · 写下代码，开启下一关。",
  "repository": { "type": "git", "url": "https://github.com/YzWushao/Codebound.git" },
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "postinstall": "node scripts/prepare-runtime.mjs && node scripts/build-icon.mjs",
    "dev": "npm run build && electron .",
    "build": "node scripts/prepare-runtime.mjs && node scripts/build-icon.mjs && vite build",
    "desktop": "electron .",
    "package:win": "npm run build && electron-builder --win --publish never",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-python": "^6.2.0",
    "@codemirror/language": "^6.11.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.36.0",
    "@lezer/highlight": "^1.2.0",
    "lucide": "^0.468.0"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "pyodide": "314.0.7",
    "vite": "8.3.5"
  },
  "build": {
    "appId": "studio.codebound.game",
    "productName": "Codebound",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "desktop/**/*", "config/**/*", "package.json"],
    "asar": true,
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "icon": "build/icon.ico", "signExecutable": false },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "artifactName": "Codebound-${version}-Setup.${ext}" }
  }
}
